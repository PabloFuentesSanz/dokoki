{
  "name": "@atlas/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Lógica pura de Atlas: sin UI, sin red, sin Supabase. Todo se ejecuta en el dispositivo.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./photos": "./src/photos/index.ts",
    "./trips": "./src/trips/index.ts",
